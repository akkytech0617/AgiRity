{
  "name": "agirity",
  "version": "0.1.0",
  "description": "Workspace management tool that automatically launches multiple applications for project work",
  "main": "dist-electron/main/index.js",
  "type": "module",
  "author": "AgiRity Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "test": "vitest run --no-color",
    "test:unit": "vitest run --no-color tests/unit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prebuild:e2e": "VITE_USE_MOCK_DATA=false tsc && vite build",
    "test:e2e": "npm run prebuild:e2e && playwright test --config=tests/e2e/playwright.config.ts",
    "test:e2e:dev": "npm run prebuild:e2e && playwright test --config=tests/e2e/playwright.config.ts tests/e2e/dev-mode-test.spec.ts",
    "test:e2e:ui": "npm run prebuild:e2e && playwright test --config=tests/e2e/playwright.config.ts --ui",
    "test:e2e:debug": "npm run prebuild:e2e && playwright test --config=tests/e2e/playwright.config.ts --debug",
    "test:smoke": "npm run prebuild:e2e && playwright test --config=tests/e2e/playwright.config.ts tests/e2e/smoke",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check . --write",
    "type-check": "tsc --pretty false -p tsconfig.json --noEmit && tsc --pretty false -p tsconfig.node.json --noEmit",
    "package": "electron-builder",
    "release": "npm run build && git tag -a v$npm_package_version -m \"v$npm_package_version\" && git push origin v$npm_package_version",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@heroui/react": "^3.2.7",
    "@heroui/styles": "^3.2.7",
    "@sentry/electron": "^7.20.2",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.12",
    "framer-motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "concurrently": "^9.2.5",
    "dotenv": "^18.0.10",
    "electron": "^45.4.1",
    "electron-builder": "^25.1.8",
    "electron-playwright-helpers": "^3.1.2",
    "js-yaml": "^5.5.0",
    "jsdom": "^31.0.1",
    "lefthook": "^2.2.2",
    "lucide-react": "^1.76.0",
    "postcss": "^8.5.33",
    "snyk": "^1.1308.4",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-electron": "^1.2.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "lefthook@2.2.2": true,
    "snyk@1.1308.4": true
  }
}
